{#- Shared shell for every page in docs/. Styles and scripts live in templates/static (copied to docs/assets). -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{% block title %}L1·L2·L3{% endblock %}</title>
<meta name="description" content="{% block description %}Headlines tell you what happened. This tells you what it's evidence of.{% endblock %}">
<script>(function(){try{var t=localStorage.getItem("l123-theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t);}catch(e){}})();</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Space+Mono:wght@400;700&display=swap">
<link rel="stylesheet" href="assets/digest.css">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230A0A0A'/%3E%3Crect x='10' y='34' width='12' height='20' fill='%23FFE500'/%3E%3Crect x='26' y='22' width='12' height='32' fill='%234D7CFF'/%3E%3Crect x='42' y='10' width='12' height='44' fill='%23FF4D6D'/%3E%3C/svg%3E">
</head>
<body class="{% block body_class %}{% endblock %}">
<div class="progress" aria-hidden="true"><span></span></div>
<header class="topbar">
  <div class="topbar-row">
    <a class="logo" href="index.html" aria-label="L1 L2 L3 archive"><span class="lv lv1">L1</span><span class="lv lv2">L2</span><span class="lv lv3">L3</span></a>
    {% block nav %}{% endblock %}
    <button class="theme-btn" type="button" aria-label="Switch colour theme"><span class="theme-ico" aria-hidden="true">◐</span><span class="theme-label">Auto</span></button>
  </div>
</header>
<main>
{% block content %}{% endblock %}
</main>
<footer class="footer">
  <div class="wrap">
    <p class="footer-big">Headlines tell you what happened.<br><mark>This tells you what it's evidence of.</mark></p>
    <p>The L1 / L2 / L3 framework is from <a href="{{ credit.url }}">{{ credit.name }}</a>; this digest is one implementation of their idea.</p>
    {% block footer_extra %}{% endblock %}
    <p class="footer-small">Punchy takes are written by an AI from the headlines and summaries only. Every "boring version" link goes to the publisher. <a href="index.html">All editions →</a></p>
  </div>
</footer>
<script src="assets/digest.js"></script>
</body>
</html>
