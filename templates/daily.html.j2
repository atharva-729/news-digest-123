{% extends "base.html.j2" %}
{% block title %}L1·L2·L3 · {{ pretty_date }}{% endblock %}
{% block description %}{{ tldr[0].text if tldr else "Today's news, explained simply." }}{% endblock %}
{% block body_class %}daily{% endblock %}

{% macro status_chip(status) -%}
<span class="chip st-{{ status }}">{{ {"new": "🆕 New", "heating": "🔥 Heating up", "cooling": "🧊 Cooling", "active": "▶ Steady", "dormant": "💤 Quiet"}[status] }}</span>
{%- endmacro %}

{% macro force_chip(f) -%}
<span class="fchip f-{{ f }}">{{ FORCE_ICONS.get(f, "•") }} {{ FORCE_LABELS.get(f, f) }}</span>
{%- endmacro %}

{% macro quiz_block(title, questions, intro) -%}
<section class="quiz" data-total="{{ questions|length }}">
  <div class="quiz-head"><h2 class="h2">{{ title }}</h2><span class="score">Score <b class="score-n">0</b>/{{ questions|length }}</span></div>
  {% if intro %}<p class="muted">{{ intro }}</p>{% endif %}
  {% for q in questions %}
  <div class="q" data-answer="{{ q.answer_index }}">
    <p class="q-text"><span class="q-n">{{ loop.index }}</span><span>{{ q.question }}{% if q.since %} <span class="muted small">(pattern since {{ q.since }})</span>{% endif %}</span></p>
    <div class="opts">
      {% for o in q.options %}<button class="opt" type="button" data-i="{{ loop.index0 }}"><span class="opt-l">{{ "ABC"[loop.index0] }}</span><span>{{ o }}</span></button>{% endfor %}
    </div>
    <p class="why" hidden>{{ q.why }}</p>
  </div>
  {% endfor %}
  <p class="quiz-done" hidden></p>
</section>
{%- endmacro %}

{% macro card(c) -%}
<article class="card s-{{ c.section }}" data-section="{{ c.section }}" id="i-{{ c.id }}">
  <div class="card-top">
    <span class="tag">{{ SECTIONS[c.section][1] }} {{ SECTIONS[c.section][0] }}</span>
    {% if c.limited %}<span class="limited" title="{{ c.limited_reason or 'only the headline was available' }}">Limited info</span>{% endif %}
  </div>
  <h3 class="headline"><span aria-hidden="true">{{ c.emoji }}</span> {{ c.headline }}</h3>
  {% if c.limited %}
  <p class="explain muted">{% if c.limited_reason == "google news link" %}This story came via Google News, which only gives the headline.{% elif c.limited_reason == "publisher blocks AI readers" %}{{ c.source }} doesn't allow AI readers to open its articles, so only its headline is used here.{% else %}Only the headline was available for this story.{% endif %}
    Rather than guess, there's no explanation; the original link has the full story.</p>
  {% else %}
  {% if c.explain %}<p class="explain">{{ c.explain }}</p>{% endif %}
  {% if c.why %}<p class="why-line"><b>Why it matters:</b> {{ c.why|hl }}</p>{% endif %}
  {% endif %}
  {% if c.funding %}
  <p class="meta-line">💰 {{ [c.funding.company, c.funding.amount, c.funding.sector, c.funding.country] | select | join(" · ") }}</p>
  {% endif %}
  {% if c.throwback %}
  <p class="meta-line">↩ <b>{{ KIND_LABELS[c.throwback.kind] }}:</b> {{ c.throwback.line }} <span class="muted">(<a href="{{ c.throwback.past.url }}">{{ c.throwback.past.date|short_date }}</a>)</span></p>
  {% endif %}
  <div class="card-foot">
    {% if c.thread %}<button class="pattern-link" type="button" data-goto="{{ c.thread.id }}">🧵 Pattern: {{ c.thread.name }} →</button>{% else %}<span class="muted small">No pattern yet</span>{% endif %}
    <a class="source-link" href="{{ c.url }}">Original: {{ c.source }} ↗</a>
  </div>
</article>
{%- endmacro %}

{% block nav %}
<nav class="tabs" role="tablist" aria-label="Edition views">
  <button class="tab" role="tab" type="button" data-tab="feed" aria-selected="true">📰 News</button>
  <button class="tab" role="tab" type="button" data-tab="means" aria-selected="false">🧠 What it means</button>
  <button class="tab" role="tab" type="button" data-tab="play" aria-selected="false">🎯 Play</button>
</nav>
{% endblock %}

{% block content %}
{# ============================== NEWS (L1) ============================== #}
<section class="panel" data-panel="feed">
  <div class="wrap">
    <header class="masthead">
      <p class="mast-date">{{ day }}, {{ pretty_date }}</p>
      <h1 class="mast-title">Today's news, <mark>explained simply.</mark></h1>
      <p class="muted">{{ stats.stories }} stories · about {{ minutes }} min · {{ stats.today_threads }} patterns moved today</p>
      <p class="explainer"><b>New here?</b> <span class="lv lv1">L1</span> what happened · <span class="lv lv2">L2</span> the pattern it's part of ·
        <span class="lv lv3">L3</span> the force behind it. <a href="index.html#how">How it works</a> · idea by <a href="{{ credit.url }}">{{ credit.name }}</a></p>
    </header>

    <section class="tldr">
      <h2 class="label">The day in 3 lines</h2>
      <ol>{% for x in tldr %}<li><span class="num">{{ loop.index }}</span><p>{{ x|hl }}</p></li>{% endfor %}</ol>
    </section>

    <div class="feed-grid">
      <div class="feed-main">
        <section class="hero">
          <h2 class="label">The big picture</h2>
          <p class="hero-text">{{ hero|hl }}</p>
          <button class="hero-cta" type="button" data-tab-link="means">See the patterns →</button>
        </section>

        <nav class="filters" aria-label="Filter by section">
          <button class="filter is-on" type="button" data-filter="all">All</button>
          {% for s in sections %}<button class="filter s-{{ s.key }}" type="button" data-filter="{{ s.key }}">{{ s.emoji }} {{ s.label }} {{ s["items"]|length }}</button>{% endfor %}
        </nav>

        {% for s in sections %}
        <div class="sec-block" data-section="{{ s.key }}">
          <h2 class="sec-head s-{{ s.key }}">{{ s.emoji }} {{ s.label }} <span class="muted small">{{ s["items"]|length }}</span></h2>
          {% for c in s["items"] %}{{ card(c) }}{% endfor %}
          {% if s.key == "tech" and (pulse.india or pulse.world) %}
          <div class="pulse">
            <h3 class="label">Who's getting startup money</h3>
            {% if pulse.india %}<p><b>🇮🇳 India:</b> {{ pulse.india }}</p>{% endif %}
            {% if pulse.world %}<p><b>🌍 Elsewhere:</b> {{ pulse.world }}</p>{% endif %}
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>

      <aside class="feed-side">
        <div class="side-box movers-box">
          <h2 class="label">Patterns that moved today <span class="swipe">swipe →</span></h2>
          <div class="movers">
          {% for m in moves %}
          <button class="mover" type="button" data-goto="{{ m.thread.id }}">
            {{ status_chip(m.kind) }}
            <span class="mover-name">{{ m.thread.name }}</span>
            <span class="mover-line">{{ m.thread.one_line }}</span>
          </button>
          {% else %}<p class="muted">Nothing moved today.</p>{% endfor %}
          </div>
        </div>
        {% if remember %}
        <button class="side-box side-remember" type="button" data-tab-link="play">
          <span class="label">🧠 Remember?</span>
          <span class="side-text">{{ remember|length }} quick question{{ "" if remember|length == 1 else "s" }} on patterns from earlier days.</span>
          <span class="side-cta">Test yourself →</span>
        </button>
        {% endif %}
      </aside>
    </div>
  </div>
</section>

{# ============================== WHAT IT MEANS (L1 / L2 / L3) ============================== #}
<section class="panel" data-panel="means" hidden>
  <div class="wrap">
    <div class="ladder">
      <div class="rung r1"><span class="rung-l">L1</span><span class="rung-t">What happened</span><span class="rung-s">one story, one day</span></div>
      <div class="rung r2"><span class="rung-l">L2</span><span class="rung-t">The pattern</span><span class="rung-s">many stories, weeks</span></div>
      <div class="rung r3"><span class="rung-l">L3</span><span class="rung-t">The force</span><span class="rung-s">the deep reason, always</span></div>
    </div>
    <p class="muted center">Stories (L1) are clues. Clues that keep repeating make a pattern (L2). Every pattern is pushed by a force (L3).</p>

    {% if map_items %}
    <div class="map-wrap">
      <h2 class="h2">The map <span class="muted small">hover a box to trace it</span></h2>
      <div class="map">
        <svg class="map-lines" aria-hidden="true"></svg>
        <div class="map-col" data-col="1">
          <div class="map-h">L1 · Stories</div>
          {% for x in map_items %}<div class="node n1 s-{{ x.card.section }}" data-id="i-{{ x.card.id }}" data-to="t-{{ x.thread.id }}">{{ x.card.headline }}</div>{% endfor %}
        </div>
        <div class="map-col" data-col="2">
          <div class="map-h">L2 · Patterns</div>
          {% for t in map_threads %}<div class="node n2 st-{{ t.status }}" data-id="t-{{ t.id }}" data-to="{% for f in t.forces %}f-{{ f }} {% endfor %}">{{ t.name }}</div>{% endfor %}
        </div>
        <div class="map-col" data-col="3">
          <div class="map-h">L3 · Forces</div>
          {% for f in forces %}<div class="node n3 f-{{ f.key }}{{ ' is-quiet' if not f.today }}" data-id="f-{{ f.key }}">{{ f.icon }} {{ f.label }}</div>{% endfor %}
        </div>
      </div>
    </div>
    {% endif %}

    {# ---- L2 first: it's what you came here to understand ---- #}
    <section class="level">
      <div class="level-h"><span class="big-l l-2">L2</span><div><h2 class="h2">The patterns</h2><p class="muted">Things that keep happening. Learn these and the news starts making sense.</p></div></div>
      <div class="force-filter" role="group" aria-label="Filter patterns by force">
        <button class="ff is-on" type="button" data-ff="all">All</button>
        {% for f in forces if f.threads %}<button class="ff f-{{ f.key }}" type="button" data-ff="{{ f.key }}">{{ f.icon }} {{ f.label }}</button>{% endfor %}
      </div>
      <div class="threads">
        {% for t in l2 %}
        <article class="thread st-{{ t.status }}" id="{{ t.id }}" data-forces="{{ t.forces|join(' ') }}">
          <div class="thread-top">{{ status_chip(t.status) }}<span class="muted small">seen {{ t.total }} time{{ "" if t.total == 1 else "s" }} since {{ t.since }}{% if t.today %} · <b>+{{ t.today }} today</b>{% endif %}</span></div>
          <h3 class="thread-name">{{ t.name }}</h3>
          <dl class="teach">
            <dt>In one line</dt><dd>{{ t.one_line }}</dd>
            {% if t.teach.like %}<dt>It's like</dt><dd>{{ t.teach.like }}</dd>{% endif %}
            {% if t.teach.why %}<dt>Why (L3)</dt><dd>{{ t.teach.why }} <span class="forces-inline">{% for f in t.forces %}{{ force_chip(f) }}{% endfor %}</span></dd>{% endif %}
          </dl>
          {% if t.teach.remember %}<p class="rule">Remember it as: <mark>{{ t.teach.remember }}</mark></p>{% endif %}
          {% if t.today_items %}
          <p class="sub-label">Today's clues</p>
          <ul class="clues">{% for e in t.today_items %}<li><a href="#i-{{ e.item_id }}" data-tab-link="feed" data-scroll="i-{{ e.item_id }}">{{ e.headline }}</a></li>{% endfor %}</ul>
          {% endif %}
          {% if t.earlier %}
          <p class="sub-label">Earlier clues</p>
          <ul class="clues">{% for e in t.earlier %}<li><span class="muted small">{{ e.date|short_date }}</span> {% if e.url %}<a href="{{ e.url }}">{{ e.title }}</a>{% else %}{{ e.title }}{% endif %}</li>{% endfor %}</ul>
          {% endif %}
          <div class="timeline" role="img" aria-label="Clues per day over the last 14 days">
            {% for d in t.timeline %}<i class="tl-d{{ ' on' if d.n }}{{ ' now' if loop.last }}" style="--n: {{ [d.n, 4]|min }}" title="{{ d.date|short_date }}: {{ d.n }}"></i>{% endfor %}
          </div>
          <div class="tl-axis"><span>14 days ago</span><span>clues per day</span><span>today</span></div>
        </article>
        {% endfor %}
      </div>
    </section>

    {# ---- L3 ---- #}
    <section class="level">
      <div class="level-h"><span class="big-l l-3">L3</span><div><h2 class="h2">The forces</h2><p class="muted">The five deep reasons behind every pattern. They never change.</p></div></div>
      <div class="forces">
        {% for f in forces %}
        <button class="force f-{{ f.key }}{{ ' is-quiet' if not f.today }}" type="button" data-force-link="{{ f.key }}">
          <span class="force-name">{{ f.icon }} {{ f.label }}</span>
          <span class="force-meaning">{{ f.meaning }}</span>
          <span class="force-line"><b>Today:</b> {{ f.line or "Quiet." }}</span>
          <span class="force-meter">{{ f.threads }} pattern{{ "" if f.threads == 1 else "s" }} · {{ f.today }} clue{{ "" if f.today == 1 else "s" }} today</span>
        </button>
        {% endfor %}
      </div>
    </section>

    {# ---- L1 ---- #}
    <section class="level">
      <div class="level-h"><span class="big-l l-1">L1</span><div><h2 class="h2">Today's stories → their pattern</h2><p class="muted">Each story, and the pattern it's a clue for.</p></div></div>
      <ul class="l1-list">
        {% for x in l1_linked %}
        <li class="l1-row s-{{ x.card.section }}">
          <a class="l1-head" href="#i-{{ x.card.id }}" data-tab-link="feed" data-scroll="i-{{ x.card.id }}">{{ x.card.headline }}</a>
          <button class="pattern-link" type="button" data-goto="{{ x.thread.id }}">🧵 {{ x.thread.nickname or x.thread.title }}</button>
        </li>
        {% endfor %}
        {% for c in l1_oneoffs %}
        <li class="l1-row s-{{ c.section }}">
          <a class="l1-head" href="#i-{{ c.id }}" data-tab-link="feed" data-scroll="i-{{ c.id }}">{{ c.headline }}</a>
          <span class="muted small">no pattern yet</span>
        </li>
        {% endfor %}
      </ul>
    </section>

    {# ---- Connections ---- #}
    {% if dots or throwbacks %}
    <section class="level">
      <div class="level-h"><span class="big-l l-x">⟷</span><div><h2 class="h2">Connecting the dots</h2><p class="muted">How today links to other patterns, and to last week.</p></div></div>
      {% if dots %}
      <div class="dots">
        <p class="dots-pair"><button class="pattern-link" type="button" data-goto="{{ dots.a.id }}">{{ dots.a.name }}</button> ⟷ <button class="pattern-link" type="button" data-goto="{{ dots.b.id }}">{{ dots.b.name }}</button> {{ force_chip(dots.force) }}</p>
        <p class="dots-text">{{ dots.text }}</p>
      </div>
      {% endif %}
      {% if throwbacks %}
      <h3 class="h3">Last week → today</h3>
      <div class="throwbacks">
        {% for x in throwbacks %}
        <article class="tb">
          <span class="kind k-{{ x.kind }}">{{ KIND_LABELS[x.kind] }}</span>
          <p class="tb-line">{{ x.line }}</p>
          <p class="tb-then"><span class="muted small">{{ x.past.date|short_date }}:</span> <a href="{{ x.past.url }}">{{ x.past.title }}</a></p>
          <p class="tb-now"><span class="muted small">Today:</span> <a href="#i-{{ x.now.id }}" data-tab-link="feed" data-scroll="i-{{ x.now.id }}">{{ x.now.headline }}</a></p>
        </article>
        {% endfor %}
      </div>
      {% endif %}
    </section>
    {% endif %}
  </div>
</section>

{# ============================== PLAY ============================== #}
<section class="panel" data-panel="play" hidden>
  <div class="wrap wrap-narrow">
    {% if remember %}{{ quiz_block("🧠 Remember?", remember, "Patterns from earlier days. Trying to recall them is what makes them stick, even if you get it wrong.") }}{% endif %}
    {% if quiz %}{{ quiz_block("Did today make sense?", quiz, "") }}{% endif %}

    {% if call %}
    <section class="call">
      <h2 class="label">🎯 Today's prediction</h2>
      <p class="call-text">{{ call.prediction }}</p>
      <p class="muted small">Pattern: <button class="pattern-link" type="button" data-goto="{{ call.thread_id }}">{{ call.thread_title }}</button> · we check on {{ call.review_by|short_date }}</p>
    </section>
    {% endif %}

    {% if past_calls %}
    <section class="calls">
      <h2 class="h2">Earlier predictions</h2>
      <ul>
        {% for c in past_calls %}
        <li><span class="verdict v-{{ c.verdict or 'open' }}">{{ {"right": "✅ Right", "wrong": "❌ Wrong", "too_early": "⏳ Too early"}.get(c.verdict, "⏳ Open") }}</span>
          <span>{{ c.prediction }}</span>
          <span class="muted small">made {{ c.made|short_date }} · check {{ c.review_by|short_date }}</span></li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  </div>
</section>
{% endblock %}

{% block footer_extra %}<p class="footer-small">Sources today: {{ sources|join(", ") }}. Explanations are written by an AI from the articles; tap "Original" to read the source.</p>{% endblock %}
