{#- Email teaser: inline styles only (email clients drop stylesheets and scripts). The full edition is the web page. -#}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ subject }}</title></head>
<body style="margin:0;padding:0;background:#FFF9EC;">
<div style="max-width:600px;margin:0 auto;padding:20px 16px;font-family:Arial,Helvetica,sans-serif;color:#0A0A0A;">
  <div style="font-family:'Arial Black',Arial,sans-serif;font-size:14px;">
    <span style="background:#FFE500;border:2px solid #0A0A0A;padding:2px 6px;">L1</span>
    <span style="background:#4D7CFF;border:2px solid #0A0A0A;padding:2px 6px;">L2</span>
    <span style="background:#FF4D6D;border:2px solid #0A0A0A;padding:2px 6px;">L3</span>
    <span style="margin-left:8px;font-family:monospace;font-size:13px;">{{ label }}</span>
  </div>
  <div style="background:#FFE500;border:3px solid #0A0A0A;border-radius:12px;padding:16px;margin:18px 0;">
    <div style="font-family:monospace;font-weight:bold;font-size:12px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;">{{ "The week" if weekly else "The day" }} in 10 seconds</div>
    {% for x in tldr %}
    <p style="margin:0 0 10px;font-family:'Arial Black',Arial,sans-serif;font-size:19px;line-height:1.2;">{{ loop.index }}. {{ x.text }}</p>
    {% endfor %}
  </div>
  {% if hero %}<p style="font-size:17px;line-height:1.45;margin:0 0 20px;"><strong>The big one:</strong> {{ hero.text }}</p>{% endif %}
  <a href="{{ url }}" style="display:inline-block;background:#0A0A0A;color:#FFE500;font-family:'Arial Black',Arial,sans-serif;font-size:17px;text-decoration:none;padding:12px 20px;border-radius:999px;">Open the full edition →</a>
  <p style="font-family:monospace;font-size:11px;color:#3A3A3A;margin-top:28px;">The L1/L2/L3 framework is from <a href="{{ credit.url }}" style="color:#3A3A3A;">{{ credit.name }}</a>.</p>
</div>
</body></html>
