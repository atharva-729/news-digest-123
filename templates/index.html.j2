{% extends "base.html.j2" %}
{% block title %}L1·L2·L3 · the archive{% endblock %}
{% block body_class %}archive-page{% endblock %}
{% block content %}
<div class="wrap">
  <header class="masthead">
    <p class="mast-date">Archive · {{ editions|length }} editions</p>
    <h1 class="mast-title">The news, <mark>explained simply.</mark></h1>
    <p class="muted">L1 is what happened. L2 is the pattern it's a clue for. L3 is the force behind it.</p>
  </header>
  <div class="archive">
    {% for e in editions %}
    <a class="tile{{ ' is-latest' if loop.first }}{{ ' is-weekly' if e.weekly }}" href="{{ e.file }}">
      <span class="tile-kind">{{ "Latest · " if loop.first }}{{ "Weekly" if e.weekly else "Daily" }}</span>
      <span class="tile-date">{{ e.day }}</span>
      <span class="tile-lead">{{ e.lead }}</span>
    </a>
    {% endfor %}
  </div>
</div>
{% endblock %}
