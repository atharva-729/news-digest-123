{% extends "base.html.j2" %}
{% block title %}L1·L2·L3 · the archive{% endblock %}
{% block body_class %}archive-page{% endblock %}
{% block content %}
<div class="wrap">
  <div class="masthead">
    <div class="mast-date"><span class="dow">Archive</span><span class="dt">{{ editions|length }} editions</span></div>
    <h1 class="mast-title">News for people<br><mark>with no attention span.</mark></h1>
    <div class="stickers">
      <span class="sticker sk-a">L1 · what happened</span>
      <span class="sticker sk-b">L2 · the pattern</span>
      <span class="sticker sk-d">L3 · the force</span>
    </div>
  </div>
  <div class="archive">
    {% for e in editions %}
    <a class="tile{{ ' is-latest' if loop.first }}{{ ' is-weekly' if e.weekly }}" href="{{ e.file }}">
      <span class="tile-kind">{{ "Latest · " if loop.first }}{{ "Weekly" if e.weekly else "Daily" }}</span>
      <span class="tile-date">{{ e.day }}</span>
      <span class="tile-lead">{{ e.lead }}</span>
    </a>
    {% endfor %}
  </div>
</div>
{% endblock %}
