{% extends "base.html.j2" %}
{% block title %}L1·L2·L3 weekly · {{ headline }}{% endblock %}
{% block description %}{{ headline }}{% endblock %}
{% block body_class %}weekly{% endblock %}
{% block nav %}<span class="tabs"><span class="tab" aria-selected="true">📆 The week</span></span>{% endblock %}

{% block content %}
<div class="wrap wrap-narrow">
  <header class="masthead">
    <p class="mast-date">Week of {{ start }} → {{ end }}</p>
    <h1 class="mast-title">{{ headline }}</h1>
    <p class="muted">{{ moved|length }} patterns moved · {{ born|length }} new · {{ died|length }} went quiet · {{ calls|length }} predictions checked</p>
  </header>

  {% if tldr %}
  <section class="tldr">
    <h2 class="label">The week in 3 lines</h2>
    <ol>{% for x in tldr %}<li><span class="num">{{ loop.index }}</span><p>{{ x|hl }}</p></li>{% endfor %}</ol>
  </section>
  {% endif %}

  <section class="hero">
    <h2 class="label">What changed</h2>
    <p class="hero-text">{{ intro|hl }}</p>
  </section>

  {% if moved %}
  <section class="level">
    <div class="level-h"><span class="big-l l-2">L2</span><div><h2 class="h2">How the patterns moved</h2><p class="muted">Each bar is a day; taller means more clues that day.</p></div></div>
    <div class="threads">
      {% for t in moved %}
      <article class="thread st-{{ t.status }}" id="{{ t.id }}">
        <div class="thread-top">
          <span class="chip st-{{ t.status }}">{{ {"new": "🆕 New", "heating": "🔥 Heating up", "cooling": "🧊 Cooling", "active": "▶ Steady", "dormant": "💤 Quiet"}[t.status] }}</span>
          <span class="muted small">+{{ t.week }} this week · {{ t.total }} since {{ t.since }}</span>
        </div>
        <h3 class="thread-name">{{ t.name }}</h3>
        <dl class="teach">
          <dt>In one line</dt><dd>{{ t.one_line }}</dd>
          {% if t.teach.like %}<dt>It's like</dt><dd>{{ t.teach.like }}</dd>{% endif %}
          {% if t.line %}<dt>This week</dt><dd>{{ t.line }}</dd>{% endif %}
        </dl>
        {% if t.teach.remember %}<p class="rule">Remember it as: <mark>{{ t.teach.remember }}</mark></p>{% endif %}
        <div class="week-stats">{% for f in t.forces %}<span class="fchip f-{{ f }}">{{ FORCE_ICONS.get(f, "•") }} {{ FORCE_LABELS.get(f, f) }}</span>{% endfor %}</div>
        <div class="timeline" role="img" aria-label="Clues per day over the last 14 days">
          {% for d in t.timeline %}<i class="tl-d{{ ' on' if d.n }}{{ ' now' if loop.last }}" style="--n: {{ [d.n, 4]|min }}" title="{{ d.date|short_date }}: {{ d.n }}"></i>{% endfor %}
        </div>
        <div class="tl-axis"><span>14 days ago</span><span>today</span></div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if born or died %}
  <section class="level">
    <div class="level-h"><span class="big-l l-x">±</span><div><h2 class="h2">New and gone quiet</h2><p class="muted">Quiet patterns stay on file. They can come back.</p></div></div>
    <div class="born-dead">
      <div class="bd"><h3 class="h3">🆕 New</h3>{% if born %}<ul>{% for t in born %}<li><b>{{ t.nickname or t.title }}</b>: {{ (t.teach or {}).one_line or t.plain or t.claim }}</li>{% endfor %}</ul>{% else %}<p class="muted">Nothing new.</p>{% endif %}</div>
      <div class="bd"><h3 class="h3">💤 Went quiet</h3>{% if died %}<ul>{% for t in died %}<li><b>{{ t.nickname or t.title }}</b>{% if t.merged_into %} (merged){% endif %}</li>{% endfor %}</ul>{% else %}<p class="muted">Everything's still going.</p>{% endif %}</div>
    </div>
  </section>
  {% endif %}

  <section class="level calls">
    <div class="level-h"><span class="big-l l-3">🎯</span><div><h2 class="h2">Predictions checked</h2><p class="muted">Judged only on news that came after the prediction.</p></div></div>
    {% if calls %}
    <ul>
      {% for c in calls %}
      <li><span class="verdict v-{{ c.shown_verdict }}">{{ {"right": "✅ Right", "wrong": "❌ Wrong", "too_early": "⏳ Too early"}[c.shown_verdict] }}</span>
        <span>{{ c.prediction }}</span>
        <span class="muted small">made {{ c.made|short_date }} on {{ c.thread_title }}. {{ c.note }}</span>
        {% for e in c.evidence %}<span class="muted small">· <a href="{{ e.url }}">{{ e.title }}</a> ({{ e.date|short_date }})</span>{% endfor %}
      </li>
      {% endfor %}
    </ul>
    {% else %}<p class="muted">No predictions due this week. {{ open_calls }} still open.</p>{% endif %}
  </section>

  {% if watch %}
  <section class="call">
    <h2 class="label">👀 Watch next week</h2>
    <p class="call-text">{{ watch }}</p>
  </section>
  {% endif %}
</div>
{% endblock %}
